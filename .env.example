# Shareable link (or agent ID) for your Eleven Labs ConvAI agent.
# Agent must be public (authentication disabled) for the widget to work.
# Server-only — parsed on Contact page and passed to the widget.
# Example: https://elevenlabs.io/app/talk-to?agent_id=agent_xxxxxxxx
NEXT_ELEVENLABS_AGENT_URL=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Eleven Labs post-call webhook signing secret
ELEVENLABS_WEBHOOK_SECRET=
